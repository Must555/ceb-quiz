{
  "matiere": "ma",
  "description": "Modèles de questions générées. Chaque tirage choisit des valeurs dans `variables`, calcule les `derivees`, vérifie les `contraintes`, puis calcule `reponse`. L'id de la variante = id du modèle + valeurs tirées (anti-répétition).",
  "modeles": [
    {
      "id": "ma-m-pourcentage-solde",
      "domaine": "ma.grandeurs",
      "type": "numerique",
      "difficulte": 2,
      "variables": {
        "p": {
          "liste": [
            {
              "nom": "Léa",
              "pr": "elle"
            },
            {
              "nom": "Nassim",
              "pr": "il"
            },
            {
              "nom": "Emma",
              "pr": "elle"
            },
            {
              "nom": "Yanis",
              "pr": "il"
            },
            {
              "nom": "Chloé",
              "pr": "elle"
            },
            {
              "nom": "Mehdi",
              "pr": "il"
            },
            {
              "nom": "Louis",
              "pr": "il"
            },
            {
              "nom": "Inès",
              "pr": "elle"
            }
          ]
        },
        "objet": {
          "liste": [
            "un vélo",
            "une trottinette",
            "un sac à dos",
            "une console",
            "des baskets",
            "un casque audio"
          ]
        },
        "prix": {
          "min": 20,
          "max": 200,
          "pas": 10
        },
        "remise": {
          "liste": [
            10,
            20,
            25,
            50
          ]
        }
      },
      "contraintes": [
        "(prix * remise) % 100 == 0"
      ],
      "enonce": "{p.nom} veut acheter {objet} à {prix} €. Pendant les soldes, il y a {remise} % de réduction. Combien va-t-{p.pr} payer ?",
      "reponse": "prix - prix * remise / 100",
      "unite": "€",
      "explication": "{remise} % de {prix} € = {prix} × {remise} ÷ 100 = {=prix * remise / 100} €. On retire la réduction : {prix} − {=prix * remise / 100} = {=prix - prix * remise / 100} €."
    },
    {
      "id": "ma-m-pourcentage-simple",
      "domaine": "ma.grandeurs",
      "type": "numerique",
      "difficulte": 1,
      "variables": {
        "p": {
          "liste": [
            5,
            10,
            20,
            25,
            50,
            75,
            150
          ]
        },
        "n": {
          "min": 20,
          "max": 800,
          "pas": 20
        }
      },
      "contraintes": [
        "(n * p) % 100 == 0"
      ],
      "enonce": "Calcule {p} % de {n} €.",
      "reponse": "n * p / 100",
      "unite": "€",
      "explication": "{p} % de {n}, c'est {n} × {p} ÷ 100 = {=n * p / 100} €."
    },
    {
      "id": "ma-m-aire-rectangle",
      "domaine": "ma.grandeurs",
      "type": "numerique",
      "difficulte": 1,
      "variables": {
        "lieu": {
          "liste": [
            "Un potager",
            "Une chambre",
            "Un terrain de jeu",
            "Une terrasse",
            "Un tapis",
            "Une piscine"
          ]
        },
        "L": {
          "min": 3,
          "max": 15
        },
        "l": {
          "min": 2,
          "max": 12
        }
      },
      "contraintes": [
        "L > l"
      ],
      "enonce": "{lieu} rectangulaire mesure {L} m de long et {l} m de large. Quelle est son aire ?",
      "reponse": "L * l",
      "unite": "m²",
      "explication": "Aire du rectangle = longueur × largeur = {L} × {l} = {=L * l} m²."
    },
    {
      "id": "ma-m-perimetre-rectangle",
      "domaine": "ma.grandeurs",
      "type": "numerique",
      "difficulte": 1,
      "variables": {
        "L": {
          "min": 4,
          "max": 40
        },
        "l": {
          "min": 2,
          "max": 30
        }
      },
      "contraintes": [
        "L > l"
      ],
      "enonce": "Pour clôturer un jardin rectangulaire de {L} m sur {l} m, combien de mètres de clôture faut-il ?",
      "reponse": "2 * (L + l)",
      "unite": "m",
      "explication": "Le périmètre, c'est le tour : ({L} + {l}) × 2 = {=2 * (L + l)} m."
    },
    {
      "id": "ma-m-aire-triangle",
      "domaine": "ma.grandeurs",
      "type": "numerique",
      "difficulte": 2,
      "variables": {
        "b": {
          "min": 4,
          "max": 20
        },
        "h": {
          "min": 3,
          "max": 16
        }
      },
      "contraintes": [
        "(b * h) % 2 == 0"
      ],
      "enonce": "Un triangle a une base de {b} cm et une hauteur de {h} cm. Quelle est son aire ?",
      "reponse": "b * h / 2",
      "unite": "cm²",
      "explication": "Aire du triangle = (base × hauteur) ÷ 2 = ({b} × {h}) ÷ 2 = {=b * h / 2} cm²."
    },
    {
      "id": "ma-m-volume-pave",
      "domaine": "ma.grandeurs",
      "type": "numerique",
      "difficulte": 2,
      "variables": {
        "L": {
          "min": 2,
          "max": 12
        },
        "l": {
          "min": 2,
          "max": 10
        },
        "h": {
          "min": 2,
          "max": 10
        }
      },
      "enonce": "Une boîte en forme de parallélépipède rectangle mesure {L} cm de long, {l} cm de large et {h} cm de haut. Quel est son volume ?",
      "reponse": "L * l * h",
      "unite": "cm³",
      "explication": "Volume = longueur × largeur × hauteur = {L} × {l} × {h} = {=L * l * h} cm³."
    },
    {
      "id": "ma-m-echelle",
      "domaine": "ma.grandeurs",
      "type": "numerique",
      "difficulte": 3,
      "variables": {
        "villes": {
          "liste": [
            {
              "a": "Liège",
              "b": "Namur"
            },
            {
              "a": "Bruxelles",
              "b": "Louvain"
            },
            {
              "a": "Mons",
              "b": "Charleroi"
            },
            {
              "a": "Gand",
              "b": "Bruges"
            },
            {
              "a": "Arlon",
              "b": "Bastogne"
            }
          ]
        },
        "cm": {
          "min": 1,
          "max": 15,
          "decimales": 1
        },
        "e": {
          "liste": [
            25000,
            50000,
            100000,
            200000,
            400000
          ]
        }
      },
      "derivees": {
        "km": "cm * e / 100000"
      },
      "contraintes": [
        "round(km, 1) == km"
      ],
      "enonce": "Sur une carte à l'échelle 1/{e}, la distance en ligne droite entre {villes.a} et {villes.b} mesure {cm} cm. Quelle est la distance réelle en kilomètres ?",
      "reponse": "km",
      "unite": "km",
      "explication": "1 cm sur la carte = {e} cm en vrai = {=e / 100000} km. Donc {cm} cm × {=e / 100000} = {=km} km."
    },
    {
      "id": "ma-m-duree-heure-fin",
      "domaine": "ma.grandeurs",
      "type": "texte_court",
      "difficulte": 2,
      "variables": {
        "activite": {
          "liste": [
            {
              "q": "Un gâteau entre au four",
              "v": "Il cuit"
            },
            {
              "q": "Un film commence",
              "v": "Il dure"
            },
            {
              "q": "Un train part de Bruxelles",
              "v": "Le trajet dure"
            },
            {
              "q": "Un match de basket commence",
              "v": "Il dure"
            }
          ]
        },
        "h": {
          "min": 8,
          "max": 19
        },
        "m": {
          "min": 0,
          "max": 55,
          "pas": 5
        },
        "d": {
          "min": 25,
          "max": 150,
          "pas": 5
        }
      },
      "derivees": {
        "fin": "h * 60 + m + d",
        "fh": "floor(fin / 60)",
        "fm": "fin % 60"
      },
      "contraintes": [
        "fm >= 10",
        "m >= 10",
        "fh < 24"
      ],
      "enonce": "{activite.q} à {h} h {m}. {activite.v} {d} minutes. À quelle heure est-ce terminé ? (exemple : 14 h 35)",
      "reponse": [
        "{fh} h {fm}",
        "{fh}h{fm}",
        "{fh} h {fm} min",
        "{fh}:{fm}"
      ],
      "souple": true,
      "explication": "{d} min = {=floor(d / 60)} h {=d % 60} min. {h} h {m} + {=floor(d / 60)} h {=d % 60} min = {fh} h {fm}."
    },
    {
