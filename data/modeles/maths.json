              "entier": 0
            },
            {
              "de": "g",
              "vers": "kg",
              "f": 0.001,
              "entier": 0
            },
            {
              "de": "cl",
              "vers": "l",
              "f": 0.01,
              "entier": 0
            },
            {
              "de": "h",
              "vers": "min",
              "f": 60,
              "entier": 1
            },
            {
              "de": "min",
              "vers": "s",
              "f": 60,
              "entier": 1
            }
          ]
        },
        "v": {
          "min": 0.5,
          "max": 60,
          "decimales": 1
        }
      },
      "derivees": {
        "r": "v * c_f"
      },
      "contraintes": [
        "round(r, 3) == r",
        "r >= 0.01",
        "c_entier == 0 || round(v) == v"
      ],
      "enonce": "Convertis : {v} {c.de} = ? {c.vers}",
      "reponse": "r",
      "unite": "{c.vers}",
      "explication": "1 {c.de} = {=c_f} {c.vers}. Donc {v} {c.de} = {v} × {=c_f} = {=r} {c.vers}."
    },
    {
      "id": "ma-m-fraction-quantite",
      "domaine": "ma.arithmetique",
      "type": "numerique",
      "difficulte": 2,
      "variables": {
        "num": {
          "min": 1,
          "max": 5
        },
        "den": {
          "liste": [
            2,
            3,
            4,
            5,
            6,
            8,
            10
          ]
        },
        "q": {
          "min": 12,
          "max": 240,
          "pas": 4
        },
        "chose": {
          "liste": [
            "billes",
            "élèves",
            "pages",
            "bonbons",
            "timbres"
          ]
        }
      },
      "contraintes": [
        "num < den",
        "q % den == 0",
        "!(num % 2 == 0 && den % 2 == 0)",
        "!(num % 3 == 0 && den % 3 == 0)",
        "!(num % 5 == 0 && den % 5 == 0)"
      ],
      "enonce": "Il y a {q} {chose}. Combien font les {num}/{den} de ces {chose} ?",
      "reponse": "q / den * num",
      "explication": "On partage en {den} : {q} ÷ {den} = {=q / den}. Puis on en prend {num} : {=q / den} × {num} = {=q / den * num}."
    },
