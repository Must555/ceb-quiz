            250
          ]
        }
      },
      "derivees": {
        "a": "x * ctx_k",
        "r": "y * ctx_k"
      },
      "contraintes": [
        "y != x",
        "round(a, 1) == a",
        "round(r, 1) == r",
        "a >= 1"
      ],
      "enonce": "{ctx.a} {x} {ctx.u1}, {ctx.b} {=a} {ctx.u2}. Combien en faut-il pour {y} {ctx.u1} ?",
      "reponse": "r",
      "explication": "Pour 1 {ctx.u1s} : {=a} ÷ {x} = {=ctx_k}. Pour {y} {ctx.u1} : {y} × {=ctx_k} = {=r} {ctx.u2}."
    },
    {
